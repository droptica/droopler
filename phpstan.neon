parameters:
    # According to https://phpstan.org/user-guide/rule-levels
    # Level 9 is most strict and it includes all checks.
    # According to Matt Glaman, Drupal app needs to run at least at level 5.
    # For the Droopler pure-D11 cleanup we target level 6 and aim for level 7+ later.
    level: 6

    # The list of paths to check.
    # This setting is ignored by PHPStorm, but it comes in handy when using terminal.
    paths:
        - droopler.install
        - droopler.profile
        - src
        - modules/custom
        - themes/custom

    fileExtensions:
        - php
        - module
        - inc
        - install
        - profile
        - theme
        - test

    # Ignore errors in certain files (remember to escape $ sign by backslash!).
    ignoreErrors:
        # https://www.drupal.org/docs/develop/development-tools/phpstan/handling-unsafe-usage-of-new-static
        - "#^Unsafe usage of new static#"
        # DI is preferred but \Drupal:: is acceptable in install / update hooks where DI is not available.
        - "#\\\\Drupal calls should be avoided in classes, use dependency injection instead#"
        # Drupal hook implementations frequently take untyped &$variables, $form, $form_state by reference.
        - "#Variable \\$form_state.*has no value type specified#"

    # Exclude paths from analysis.
    excludePaths:
        - vendor
        - */vendor/*
        - modules/contrib
        - themes/contrib
        - */node_modules/*
        - */dist/*
        - */build/*

    # Minimum supported PHP version for the Droopler pure-D11 release.
    phpVersion: 80300

    # Keep PHPDoc-only types loose while migrating; tighten once src/ has full type coverage.
    treatPhpDocTypesAsCertain: false

    # Speeds up repeated CI runs when vendor cache is restored.
    tmpDir: .phpstan-cache

    # mglaman/phpstan-drupal needs to locate Drupal core. When running from the
    # profile root with `composer install` performed inside the profile, core is
    # pulled into vendor/drupal/core, so we point drupal_root one level up.
    drupal:
        drupal_root: %currentWorkingDirectory%/vendor/drupal
